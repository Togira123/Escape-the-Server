// FloatParameter:14
	float n_out14p0 = dissolve_progress;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out4p0.x;
	ALPHA_SCISSOR_THRESHOLD = n_out14p0;


}
