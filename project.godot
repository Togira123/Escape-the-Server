[layer_names]

3d_physics/layer_1="Ground"
3d_physics/layer_2="LetterGroundCollision"
3d_physics/layer_3="LetterPlayerCollision"
3d_physics/layer_4="Player (no masks detecting this)"
3d_physics/layer_5="Laser"
3d_physics/layer_6="Jumppad"
3d_physics/layer_7="Collectibles"
3d_physics/layer_8="Portal"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
gl_compatibility/item_buffer_size=32768
limits/global_shader_variables/buffer_size=16384
