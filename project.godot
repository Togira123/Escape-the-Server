; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Discord Activity"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Discord="*res://plugins/DiscordEmbeddedSDK/DiscordSDK.gd"
Client="*res://scripts/multiplayer/client.gd"
Global="*res://scripts/portal/global.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor]

export/convert_text_resources_to_binary=false

[filesystem]

import/blender/enabled=false

[global_group]

module="Group for all ground modules"
other_players="all players but the own one are in this group"
player="The controllable player"

